# ── KROTO environment (copy to .env) ─────────────────────────────
NODE_ENV=development

# Postgres / Redis
POSTGRES_DB=kroto
POSTGRES_USER=kroto
POSTGRES_PASSWORD=change-me-strong-password
REDIS_PASSWORD=change-me-redis-password
DATABASE_URL=postgresql://kroto:change-me-strong-password@localhost:5432/kroto?schema=public
REDIS_URL=redis://:change-me-redis-password@localhost:6379

# API
PORT=3001
APP_BASE_URL=http://localhost
NEXT_PUBLIC_API_URL=http://localhost/api

# JWT — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Field-level encryption for inventory codes + TOTP secrets (NEVER commit real keys)
CODE_ENCRYPTION_KEY=replace-me-32-byte-base64-key

# Payment provider: btcpay | nowpayments
PAYMENT_PROVIDER=btcpay
# BTCPay Server — leave URL/KEY EMPTY for OFFLINE DEMO mode (simulated payments, full flow works)
BTCPAY_URL=https://btcpay.local
BTCPAY_API_KEY=replace-me            # Greenfield API key (no private keys, ever)
BTCPAY_STORE_ID=your-store-id
BTCPAY_WEBHOOK_SECRET=replace-me     # HMAC secret proving webhook authenticity
PUBLIC_WEB_URL=https://yourdomain.com  # base URL BTCPay calls back: {PUBLIC_WEB_URL}/api/webhooks/btcpay
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Rate lock window (minutes) and per-network confirmations are stored in `settings`
# and editable from the admin panel.

# Email (Resend)
RESEND_API_KEY=re_replace_me
MAIL_FROM="متجر كروتو <orders@mail.kroto.example.com>"

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Hot-wallet sweep threshold (USD). Sweep sends to COLD_WALLET_ADDRESS via BTCPay;
# this app NEVER holds private keys.
SWEEP_THRESHOLD_USD=500
COLD_WALLET_ADDRESS=

# Caddy
CADDY_EMAIL=admin@kroto.example.com
